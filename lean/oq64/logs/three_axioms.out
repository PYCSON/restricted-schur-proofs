def OQ64.colB : Nat → Nat → Nat → Bool :=
fun j m x => decide (x ≤ j) || decide (m < x)
OQ64.three_block : ∀ (k l j m V D T : Nat),
  2 ≤ l →
    l ≤ k →
      2 * D = l * (l - 1) →
        2 * T = l * (l + 1) →
          m = (k - l) * (j + 1) + l * j + T - 1 →
            V = T + (m - j) * (l - j) + (k - l) → ¬OQ64.ExactSol k l (V - 1) (OQ64.colB j m)
OQ64.three_V_eq : ∀ (j q m e T : Nat),
  j ≤ m →
    2 * T = (j + q) * (j + q + 1) → 2 * (T + (m - j) * q + e) = j * (j + 1) + 2 * q * (m + 1) + q * (q - 1) + 2 * e
OQ64.S2_20_19_gt_F : ∃ c, ¬OQ64.ExactSol 20 19 (OQ64.F 20 19) c
OQ64.S2_21_20_gt_F : ∃ c, ¬OQ64.ExactSol 21 20 (OQ64.F 21 20) c
OQ64.S2_20_20_ge : ¬OQ64.ExactSol 20 20 4769 (OQ64.colB 4 289)
'OQ64.three_block' depends on axioms: [propext, Classical.choice, Quot.sound]
'OQ64.three_V_eq' depends on axioms: [propext, Quot.sound]
'OQ64.S2_20_19_gt_F' depends on axioms: [propext, Classical.choice, Quot.sound]
'OQ64.S2_21_20_gt_F' depends on axioms: [propext, Classical.choice, Quot.sound]
'OQ64.S2_20_20_ge' depends on axioms: [propext, Classical.choice, Quot.sound]
