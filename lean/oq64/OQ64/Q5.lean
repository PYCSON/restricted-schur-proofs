/-! # ℓ = 5: S₂(k;5) ≤ F(k,5) + 6 for every k ≥ 5 (generated by gen_lean_kernel.py) -/

@[expose] public section

namespace OQ64
open RSN

theorem q5E0_ok : q5E0.all (edgeOK 5 5 6 q5V q5F) = true := by decide +kernel
theorem q5E1_ok : q5E1.all (edgeOK 5 5 6 q5V q5F) = true := by decide +kernel
theorem q5E2_ok : q5E2.all (edgeOK 5 5 6 q5V q5F) = true := by decide +kernel
theorem q5E3_ok : q5E3.all (edgeOK 5 5 6 q5V q5F) = true := by decide +kernel
theorem q5E4_ok : q5E4.all (edgeOK 5 5 6 q5V q5F) = true := by decide +kernel
theorem q5E5_ok : q5E5.all (edgeOK 5 5 6 q5V q5F) = true := by decide +kernel
theorem q5E6_ok : q5E6.all (edgeOK 5 5 6 q5V q5F) = true := by decide +kernel
theorem q5E7_ok : q5E7.all (edgeOK 5 5 6 q5V q5F) = true := by decide +kernel

theorem q5E_ok : q5Es.flatten.all (edgeOK 5 5 6 q5V q5F) = true := by
  rw [List.all_eq_true]
  intro e he
  simp only [List.mem_flatten, q5Es, List.mem_cons, List.not_mem_nil, or_false] at he
  obtain ⟨L, hL, heL⟩ := he
  rcases hL with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · exact List.all_eq_true.1 q5E0_ok e heL
  · exact List.all_eq_true.1 q5E1_ok e heL
  · exact List.all_eq_true.1 q5E2_ok e heL
  · exact List.all_eq_true.1 q5E3_ok e heL
  · exact List.all_eq_true.1 q5E4_ok e heL
  · exact List.all_eq_true.1 q5E5_ok e heL
  · exact List.all_eq_true.1 q5E6_ok e heL
  · exact List.all_eq_true.1 q5E7_ok e heL

theorem q5C0_eq : edgeClauses q5E0 = q5C0 := by decide +kernel
theorem q5C1_eq : edgeClauses q5E1 = q5C1 := by decide +kernel
theorem q5C2_eq : edgeClauses q5E2 = q5C2 := by decide +kernel
theorem q5C3_eq : edgeClauses q5E3 = q5C3 := by decide +kernel
theorem q5C4_eq : edgeClauses q5E4 = q5C4 := by decide +kernel
theorem q5C5_eq : edgeClauses q5E5 = q5C5 := by decide +kernel
theorem q5C6_eq : edgeClauses q5E6 = q5C6 := by decide +kernel
theorem q5C7_eq : edgeClauses q5E7 = q5C7 := by decide +kernel

theorem q5map_eq : q5Es.map edgeClauses = q5Cs := by
  simp only [q5Es, q5Cs, List.map_cons, List.map_nil, q5C0_eq, q5C1_eq, q5C2_eq, q5C3_eq, q5C4_eq, q5C5_eq, q5C6_eq, q5C7_eq]

def q5Chunks : List (List Clause) := [[2 * (q5u + 1)]] :: q5Cs

def q5CNF : List Clause := q5Chunks.flatten

noncomputable def q5Db0 : Trie := buildChunksF q5Chunks .leaf 1

theorem q5Db0_eq : q5Db0 = buildDB .leaf 1 q5CNF := by
  rw [q5Db0, buildChunksF_eq, buildChunks_eq]
  rfl

noncomputable def q5Db1 : Trie := insertStepsF q5Seg0 q5Db0
noncomputable def q5Db2 : Trie := insertStepsF q5Seg1 q5Db1
noncomputable def q5Db3 : Trie := insertStepsF q5Seg2 q5Db2
noncomputable def q5Db4 : Trie := insertStepsF q5Seg3 q5Db3
noncomputable def q5Db5 : Trie := insertStepsF q5Seg4 q5Db4
noncomputable def q5Db6 : Trie := insertStepsF q5Seg5 q5Db5
noncomputable def q5Db7 : Trie := insertStepsF q5Seg6 q5Db6
theorem q5Seg0_ok : checkSegF q5Seg0 q5Db0 = true := by decide +kernel
theorem q5Seg1_ok : checkSegF q5Seg1 q5Db1 = true := by decide +kernel
theorem q5Seg2_ok : checkSegF q5Seg2 q5Db2 = true := by decide +kernel
theorem q5Seg3_ok : checkSegF q5Seg3 q5Db3 = true := by decide +kernel
theorem q5Seg4_ok : checkSegF q5Seg4 q5Db4 = true := by decide +kernel
theorem q5Seg5_ok : checkSegF q5Seg5 q5Db5 = true := by decide +kernel
theorem q5Seg6_ok : checkSegF q5Seg6 q5Db6 = true := by decide +kernel

def q5Segs : List (List Step) := [q5Seg0, q5Seg1, q5Seg2, q5Seg3, q5Seg4, q5Seg5, q5Seg6]

theorem q5Segs_okF : SegsOKF q5Db0 q5Segs := by
  simp only [q5Segs, SegsOKF]
  exact ⟨q5Seg0_ok, q5Seg1_ok, q5Seg2_ok, q5Seg3_ok, q5Seg4_ok, q5Seg5_ok, q5Seg6_ok, trivial⟩

theorem q5Segs_empty : q5Segs.flatten.any (fun s => s.clause.isEmpty) = true := by decide +kernel

theorem q5_unsat (v : Nat → Bool) : ∃ c ∈ kernelCNF q5u q5Es.flatten, clauseEval v c = false := by
  have h := segsOKF_iff q5Segs q5Db0 q5Segs_okF
  rw [q5Db0_eq] at h
  have h2 := unsat_of_segs q5CNF q5Segs h q5Segs_empty v
  rw [kernelCNF_chunks q5u q5Es q5Cs q5map_eq]
  exact h2

theorem q5_u : vtx q5V q5u = [1, 0, 0] := by decide

/-- **ℓ = 5.** For every `k ≥ 5`, every 2-colouring of `[1, F(k,5) + 6]` (here `natv q5F k = F(k,5) + 6`, with `6 = (ℓ−1)(ℓ−2)/2`) has a monochromatic solution of
`x₁ + ⋯ + x_k = x_{k+1}` with exactly 6 distinct integers. -/
theorem q5_upper (k : Nat) (hk : 5 ≤ k) (c : Nat → Bool) : ExactSol k 5 (natv q5F k) c :=
  kernel_upper 5 5 6 q5V q5Es.flatten q5F q5u q5_u q5E_ok q5_unsat k hk c

end OQ64
