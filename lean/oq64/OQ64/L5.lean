module

public import OQ64.Kernel
public import RSN.Fast
public import OQ64.Data.L5
public import OQ64.Data.L5Seg0

/-! # ℓ = 5: S₂(k;5) ≤ F(k,5) for every k ≥ 6 (generated by gen_lean_kernel.py) -/

@[expose] public section

namespace OQ64
open RSN

theorem l5E0_ok : l5E0.all (edgeOK 5 6 8 l5V l5F) = true := by decide +kernel
theorem l5E1_ok : l5E1.all (edgeOK 5 6 8 l5V l5F) = true := by decide +kernel
theorem l5E2_ok : l5E2.all (edgeOK 5 6 8 l5V l5F) = true := by decide +kernel
theorem l5E3_ok : l5E3.all (edgeOK 5 6 8 l5V l5F) = true := by decide +kernel
theorem l5E4_ok : l5E4.all (edgeOK 5 6 8 l5V l5F) = true := by decide +kernel

theorem l5E_ok : l5Es.flatten.all (edgeOK 5 6 8 l5V l5F) = true := by
  rw [List.all_eq_true]
  intro e he
  simp only [List.mem_flatten, l5Es, List.mem_cons, List.not_mem_nil, or_false] at he
  obtain ⟨L, hL, heL⟩ := he
  rcases hL with rfl | rfl | rfl | rfl | rfl
  · exact List.all_eq_true.1 l5E0_ok e heL
  · exact List.all_eq_true.1 l5E1_ok e heL
  · exact List.all_eq_true.1 l5E2_ok e heL
  · exact List.all_eq_true.1 l5E3_ok e heL
  · exact List.all_eq_true.1 l5E4_ok e heL

theorem l5C0_eq : edgeClauses l5E0 = l5C0 := by decide +kernel
theorem l5C1_eq : edgeClauses l5E1 = l5C1 := by decide +kernel
theorem l5C2_eq : edgeClauses l5E2 = l5C2 := by decide +kernel
theorem l5C3_eq : edgeClauses l5E3 = l5C3 := by decide +kernel
theorem l5C4_eq : edgeClauses l5E4 = l5C4 := by decide +kernel

theorem l5map_eq : l5Es.map edgeClauses = l5Cs := by
  simp only [l5Es, l5Cs, List.map_cons, List.map_nil, l5C0_eq, l5C1_eq, l5C2_eq, l5C3_eq, l5C4_eq]

def l5Chunks : List (List Clause) := [[2 * (l5u + 1)]] :: l5Cs

def l5CNF : List Clause := l5Chunks.flatten

noncomputable def l5Db0 : Trie := buildChunksF l5Chunks .leaf 1

theorem l5Db0_eq : l5Db0 = buildDB .leaf 1 l5CNF := by
  rw [l5Db0, buildChunksF_eq, buildChunks_eq]
  rfl

noncomputable def l5Db1 : Trie := insertStepsF l5Seg0 l5Db0
noncomputable def l5Db2 : Trie := insertStepsF l5Seg1 l5Db1
noncomputable def l5Db3 : Trie := insertStepsF l5Seg2 l5Db2
noncomputable def l5Db4 : Trie := insertStepsF l5Seg3 l5Db3
theorem l5Seg0_ok : checkSegF l5Seg0 l5Db0 = true := by decide +kernel
theorem l5Seg1_ok : checkSegF l5Seg1 l5Db1 = true := by decide +kernel
theorem l5Seg2_ok : checkSegF l5Seg2 l5Db2 = true := by decide +kernel
theorem l5Seg3_ok : checkSegF l5Seg3 l5Db3 = true := by decide +kernel

def l5Segs : List (List Step) := [l5Seg0, l5Seg1, l5Seg2, l5Seg3]

theorem l5Segs_okF : SegsOKF l5Db0 l5Segs := by
  simp only [l5Segs, SegsOKF]
  exact ⟨l5Seg0_ok, l5Seg1_ok, l5Seg2_ok, l5Seg3_ok, trivial⟩

theorem l5Segs_empty : l5Segs.flatten.any (fun s => s.clause.isEmpty) = true := by decide +kernel

theorem l5_unsat (v : Nat → Bool) : ∃ c ∈ kernelCNF l5u l5Es.flatten, clauseEval v c = false := by
  have h := segsOKF_iff l5Segs l5Db0 l5Segs_okF
  rw [l5Db0_eq] at h
  have h2 := unsat_of_segs l5CNF l5Segs h l5Segs_empty v
  rw [kernelCNF_chunks l5u l5Es l5Cs l5map_eq]
  exact h2

theorem l5_u : vtx l5V l5u = [1, 0, 0] := by decide

/-- **ℓ = 5.** For every `k ≥ 6`, every 2-colouring of `[1, F(k,5)]` has a monochromatic solution of
`x₁ + ⋯ + x_k = x_{k+1}` with exactly 6 distinct integers. -/
theorem l5_upper (k : Nat) (hk : 6 ≤ k) (c : Nat → Bool) : ExactSol k 5 (natv l5F k) c :=
  kernel_upper 5 6 8 l5V l5Es.flatten l5F l5u l5_u l5E_ok l5_unsat k hk c

end OQ64
