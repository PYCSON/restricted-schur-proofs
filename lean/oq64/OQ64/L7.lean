theorem l7Segs_empty : l7Segs.flatten.any (fun s => s.clause.isEmpty) = true := by decide +kernel

theorem l7_unsat (v : Nat → Bool) : ∃ c ∈ kernelCNF l7u l7Es.flatten, clauseEval v c = false := by
  have h := segsOKF_iff l7Segs l7Db0 l7Segs_okF
  rw [l7Db0_eq] at h
  have h2 := unsat_of_segs l7CNF l7Segs h l7Segs_empty v
  rw [kernelCNF_chunks l7u l7Es l7Cs l7map_eq]
  exact h2

theorem l7_u : vtx l7V l7u = [1, 0, 0] := by decide

/-- **ℓ = 7.** For every `k ≥ 8`, every 2-colouring of `[1, F(k,7)]` has a monochromatic solution of
`x₁ + ⋯ + x_k = x_{k+1}` with exactly 8 distinct integers. -/
theorem l7_upper (k : Nat) (hk : 8 ≤ k) (c : Nat → Bool) : ExactSol k 7 (natv l7F k) c :=
  kernel_upper 7 8 8 l7V l7Es.flatten l7F l7u l7_u l7E_ok l7_unsat k hk c

