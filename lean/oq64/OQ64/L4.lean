module

public import OQ64.Kernel
public import RSN.Fast
public import OQ64.Data.L4
public import OQ64.Data.L4Seg0

/-! # ℓ = 4: S₂(k;4) ≤ F(k,4) for every k ≥ 4 (generated by gen_lean_kernel.py) -/

@[expose] public section

namespace OQ64
open RSN

theorem l4E0_ok : l4E0.all (edgeOK 4 4 6 l4V l4F) = true := by decide +kernel
theorem l4E1_ok : l4E1.all (edgeOK 4 4 6 l4V l4F) = true := by decide +kernel

theorem l4E_ok : l4Es.flatten.all (edgeOK 4 4 6 l4V l4F) = true := by
  rw [List.all_eq_true]
  intro e he
  simp only [List.mem_flatten, l4Es, List.mem_cons, List.not_mem_nil, or_false] at he
  obtain ⟨L, hL, heL⟩ := he
  rcases hL with rfl | rfl
  · exact List.all_eq_true.1 l4E0_ok e heL
  · exact List.all_eq_true.1 l4E1_ok e heL

theorem l4C0_eq : edgeClauses l4E0 = l4C0 := by decide +kernel
theorem l4C1_eq : edgeClauses l4E1 = l4C1 := by decide +kernel

theorem l4map_eq : l4Es.map edgeClauses = l4Cs := by
  simp only [l4Es, l4Cs, List.map_cons, List.map_nil, l4C0_eq, l4C1_eq]

def l4Chunks : List (List Clause) := [[2 * (l4u + 1)]] :: l4Cs

def l4CNF : List Clause := l4Chunks.flatten

noncomputable def l4Db0 : Trie := buildChunksF l4Chunks .leaf 1

theorem l4Db0_eq : l4Db0 = buildDB .leaf 1 l4CNF := by
  rw [l4Db0, buildChunksF_eq, buildChunks_eq]
  rfl

noncomputable def l4Db1 : Trie := insertStepsF l4Seg0 l4Db0
noncomputable def l4Db2 : Trie := insertStepsF l4Seg1 l4Db1
noncomputable def l4Db3 : Trie := insertStepsF l4Seg2 l4Db2
theorem l4Seg0_ok : checkSegF l4Seg0 l4Db0 = true := by decide +kernel
theorem l4Seg1_ok : checkSegF l4Seg1 l4Db1 = true := by decide +kernel
theorem l4Seg2_ok : checkSegF l4Seg2 l4Db2 = true := by decide +kernel

def l4Segs : List (List Step) := [l4Seg0, l4Seg1, l4Seg2]

theorem l4Segs_okF : SegsOKF l4Db0 l4Segs := by
  simp only [l4Segs, SegsOKF]
  exact ⟨l4Seg0_ok, l4Seg1_ok, l4Seg2_ok, trivial⟩

theorem l4Segs_empty : l4Segs.flatten.any (fun s => s.clause.isEmpty) = true := by decide +kernel

theorem l4_unsat (v : Nat → Bool) : ∃ c ∈ kernelCNF l4u l4Es.flatten, clauseEval v c = false := by
  have h := segsOKF_iff l4Segs l4Db0 l4Segs_okF
  rw [l4Db0_eq] at h
  have h2 := unsat_of_segs l4CNF l4Segs h l4Segs_empty v
  rw [kernelCNF_chunks l4u l4Es l4Cs l4map_eq]
  exact h2

theorem l4_u : vtx l4V l4u = [1, 0, 0] := by decide

/-- **ℓ = 4.** For every `k ≥ 4`, every 2-colouring of `[1, F(k,4)]` has a monochromatic solution of
`x₁ + ⋯ + x_k = x_{k+1}` with exactly 5 distinct integers. -/
theorem l4_upper (k : Nat) (hk : 4 ≤ k) (c : Nat → Bool) : ExactSol k 4 (natv l4F k) c :=
  kernel_upper 4 4 6 l4V l4Es.flatten l4F l4u l4_u l4E_ok l4_unsat k hk c

end OQ64
