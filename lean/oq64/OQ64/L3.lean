module

public import OQ64.Kernel
public import RSN.Fast
public import OQ64.Data.L3
public import OQ64.Data.L3Seg0

/-! # ℓ = 3: S₂(k;3) ≤ F(k,3) for every k ≥ 3 (generated by gen_lean_kernel.py) -/

@[expose] public section

namespace OQ64
open RSN

theorem l3E0_ok : l3E0.all (edgeOK 3 3 4 l3V l3F) = true := by decide +kernel

theorem l3E_ok : l3Es.flatten.all (edgeOK 3 3 4 l3V l3F) = true := by
  rw [List.all_eq_true]
  intro e he
  simp only [List.mem_flatten, l3Es, List.mem_cons, List.not_mem_nil, or_false] at he
  obtain ⟨L, hL, heL⟩ := he
  rcases hL with rfl
  · exact List.all_eq_true.1 l3E0_ok e heL

theorem l3C0_eq : edgeClauses l3E0 = l3C0 := by decide +kernel

theorem l3map_eq : l3Es.map edgeClauses = l3Cs := by
  simp only [l3Es, l3Cs, List.map_cons, List.map_nil, l3C0_eq]

def l3Chunks : List (List Clause) := [[2 * (l3u + 1)]] :: l3Cs

def l3CNF : List Clause := l3Chunks.flatten

noncomputable def l3Db0 : Trie := buildChunksF l3Chunks .leaf 1

theorem l3Db0_eq : l3Db0 = buildDB .leaf 1 l3CNF := by
  rw [l3Db0, buildChunksF_eq, buildChunks_eq]
  rfl

noncomputable def l3Db1 : Trie := insertStepsF l3Seg0 l3Db0
theorem l3Seg0_ok : checkSegF l3Seg0 l3Db0 = true := by decide +kernel

def l3Segs : List (List Step) := [l3Seg0]

theorem l3Segs_okF : SegsOKF l3Db0 l3Segs := by
  simp only [l3Segs, SegsOKF]
  exact ⟨l3Seg0_ok, trivial⟩

theorem l3Segs_empty : l3Segs.flatten.any (fun s => s.clause.isEmpty) = true := by decide +kernel

theorem l3_unsat (v : Nat → Bool) : ∃ c ∈ kernelCNF l3u l3Es.flatten, clauseEval v c = false := by
  have h := segsOKF_iff l3Segs l3Db0 l3Segs_okF
  rw [l3Db0_eq] at h
  have h2 := unsat_of_segs l3CNF l3Segs h l3Segs_empty v
  rw [kernelCNF_chunks l3u l3Es l3Cs l3map_eq]
  exact h2

theorem l3_u : vtx l3V l3u = [1, 0, 0] := by decide

/-- **ℓ = 3.** For every `k ≥ 3`, every 2-colouring of `[1, F(k,3)]` has a monochromatic solution of
`x₁ + ⋯ + x_k = x_{k+1}` with exactly 4 distinct integers. -/
theorem l3_upper (k : Nat) (hk : 3 ≤ k) (c : Nat → Bool) : ExactSol k 3 (natv l3F k) c :=
  kernel_upper 3 3 4 l3V l3Es.flatten l3F l3u l3_u l3E_ok l3_unsat k hk c

end OQ64
